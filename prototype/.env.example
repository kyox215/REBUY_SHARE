# E2a local email OTP only. Keep values in ignored prototype/.env.local with mode 600.
# The server selects local-auth only when both server-only values pass the canonical local
# Supabase validation; if either value is missing or invalid, the app stays ui-only.
# Use only the local API URL and public publishable/anon credential; a future browser client
# must receive validated config explicitly. Do not add NEXT_PUBLIC_* aliases.
# Never use hosted credentials, service_role keys, SMTP secrets, or real PII.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
