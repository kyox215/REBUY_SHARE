# Server-only Auth configuration. Keep local values in ignored prototype/.env.local with mode 600;
# configure hosted values as environment-scoped sensitive values in Vercel. Invalid or incomplete
# combinations fail closed to ui-only. Never add NEXT_PUBLIC_* aliases or privileged credentials.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Hosted-only exact HTTPS production origin. Vercel's immutable VERCEL_URL is accepted only for the
# current Preview/Production deployment; arbitrary Host/X-Forwarded-Host values are rejected.
REBUY_APP_ORIGIN=

# Hosted-only, comma-separated pilot allowlist. Keep it server-side/sensitive and do not commit real
# addresses. Denied request/resend calls return the same generic success shape to resist enumeration.
REBUY_AUTH_ALLOWED_EMAILS=
