# E2a local email OTP only. Keep values in ignored prototype/.env.local with mode 600.
# These names are server-only. Use only the local API URL and public publishable/anon credential
# emitted by local Supabase; a future browser client must receive validated config explicitly.
# Never use hosted credentials, service_role keys, SMTP secrets, or real PII.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
